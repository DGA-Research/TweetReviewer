# Copy to .env and fill in. Never commit the real .env (it is gitignored).
#
# Deployed on Coolify? Set these in Coolify's Environment Variables panel instead.

# ----- GitHub storage -----
# Use a fine-grained Personal Access Token scoped to ONLY this repo,
# with Contents: Read and write permission.
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=DGA-Research
GITHUB_REPO=TweetReviewer

# The branch the app's CODE is deployed from. Data is never written here.
GITHUB_BRANCH=feature/Tweet-Reviewer-VPS

# The branch reviews and inputs are stored on. This MUST NOT be the deploy
# branch above when Coolify's Auto Deploy is on: the app commits every 20
# actions, so each auto-push would fire the deploy webhook and restart the
# container mid-review, logging everyone out and wiping their progress.
# Created automatically off GITHUB_BRANCH the first time it is needed.
GITHUB_DATA_BRANCH=review-data

# Folders inside the repo where files are stored.
GITHUB_INPUTS_DIR=inputs
GITHUB_REVIEWS_DIR=reviews

# ----- Session working files -----
# Hours an idle session's in-RAM working files are kept before being swept.
# Sessions survive a page refresh, so this bounds how long they accumulate.
# Set to 0 to disable sweeping. Default: 72
SESSION_TTL_HOURS=72

# ----- App password (in-app gate) -----
# Shared login for the research team. If unset, no password is required.
# Only used when running locally or on a server without external auth.
STREAMLIT_PASSWORD=your-secure-password-here
